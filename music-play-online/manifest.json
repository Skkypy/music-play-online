{
  "manifest_version": 3,
  "name": "Music Play Online",
  "version": "1.0.0",
  "description": "聚合多种在线音乐源的播放器插件，支持歌曲宝等平台",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.gequbao.com/*",
    "https://*.gequbao.com/*"
  ],
  "icons": {
    "16": "shared/icons/icon16.png",
    "48": "shared/icons/icon48.png",
    "128": "shared/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "shared/icons/icon16.png",
      "48": "shared/icons/icon48.png",
      "128": "shared/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.gequbao.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}